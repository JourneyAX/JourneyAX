{
  "_comment": "How the assistant decides what to do each turn: ask, recommend, show or answer. Every number, word list and sentence below is platform default data; a pack overrides any section under extensions.dialoguePolicy (validated when saved). Nothing here is specific to a department or a tenant.",
  "version": "1.0.0",
  "stopwords": ["a","about","above","after","again","all","am","an","and","any","are","as","at","be","because","been","before","being","below","between","both","but","by","can","could","did","do","does","doing","down","during","each","few","for","from","further","had","has","have","having","he","her","here","hers","him","his","how","i","if","in","into","is","it","its","just","me","more","most","my","no","nor","not","of","off","on","once","only","or","other","our","ours","out","over","own","same","she","should","so","some","such","than","that","the","their","theirs","them","then","there","these","they","this","those","through","to","too","under","until","up","very","was","we","were","what","when","where","which","while","who","whom","why","will","with","would","you","your","yours","ll","ve","re","d","s","t","m"],
  "fillerWords": ["need","needs","needed","want","wants","wanted","looking","look","find","get","got","buy","buying","show","please","help","something","anything","thing","things","stuff","sell","stock","product","products","item","items","option","options","one","ones","kind","type","sort","like","also","really","much","many","lot","bit","new","good","best","right","great","nice","answers","answer","thanks","thank","hi","hello","hey","use","using","used","method"],
  "genericProductWords": ["pack","box","set","kit","each","pk","pcs","piece","pieces","bulk","ml","l","kg","g","mm","cm","m","per","inc","incl","with","without","assorted"],
  "stem": { "rules": [["ies","y"],["ing",""],["ed",""],["es",""],["s",""]], "minStem": 3, "keepEndings": ["ss","us","is"] },
  "relevance": { "fieldWeights": { "title": 3, "features": 2, "description": 1, "brand": 1, "category": 1 }, "minIdf": 0.3 },
  "sufficiency": { "minTopScore": 1.2, "margin": 0.3, "within": 0.6, "maxRecommended": 3, "minNeedShare": 0.5 },
  "show": { "maxItems": 6 },
  "ask": { "maxPerConcept": 2, "noPreference": "No preference" },
  "facets": {
    "enabled": true,
    "minCandidatesToAsk": 8,
    "maxExpectedRemaining": 0.65,
    "maxOptions": 4,
    "minShare": 0.12,
    "maxTermShare": 0.6,
    "price": { "minRatio": 2, "askFirst": false },
    "priority": { "term": 0, "brand": 0.05, "price": 0.1 },
    "questions": { "term": "Which of these is closest to what you need?", "brand": "Is there a brand you prefer?", "price": "Roughly what budget are you working to?" },
    "priceLabels": { "under": "Under {a}", "between": "{a} to {b}", "over": "Over {b}" }
  },
  "reason": { "maxChars": 150, "maxSentences": 2 },
  "answerPhrases": ["how do i","how to","how can i","how would i","instructions","directions","how long does","how many coats","what is the difference","difference between","compare","versus","vs"],
  "howToPhrases": ["how do i","how to","how can i","how would i","how should i","instructions","directions"],
  "usageCues": ["apply","spray","brush","roll","mix","dilute","stir","shake","leave","allow","wipe","rinse","scrub","pour","spread","soak","wait","minutes","hours","coat","coats"],
  "howTo": { "maxSentences": 3, "maxChars": 320 },
  "browsePhrases": ["show me","show all","see all","see everything","browse","list all","what do you have","what have you got","what do you sell","everything you have"],
  "modelReading": { "skipForTappedAnswers": true, "skipForBrowse": true, "browseMaxWords": 8, "maxHeaderWords": 3 },
  "wording": "template",
  "templates": {
    "ask": ["A quick question first, so I can point you to the right ones.", "One quick question so I get you the right thing."],
    "askMany": ["There's a lot to choose from here, so one quick question first.", "Plenty to choose from, so one quick question to narrow it down."],
    "recommendOne": ["For {needs}, I'd go with the {title}.", "The {title} looks like the best fit for {needs}."],
    "recommendMany": ["These fit {needs} best.", "Here's what suits {needs}."],
    "show": ["Here's what we have.", "These are the closest matches."],
    "showNeeds": ["Here's what we have for {needs}.", "These are the closest matches for {needs}."],
    "why": "For {needs}: {excerpt}",
    "whyNoExcerpt": "Matches what you asked for: {needs}.",
    "howTo": "Here's how the {title} is used, from its product details: {steps}",
    "howToNone": "I don't have usage instructions for the {title} on file. One of our team can help with that.",
    "headingRecommend": "Best fit for what you told me",
    "headingShow": "What we have",
    "eyebrowRecommend": "Best fit",
    "eyebrowShow": "From our range"
  }
}
