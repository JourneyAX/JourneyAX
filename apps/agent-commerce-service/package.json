{
  "name": "agent-commerce-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "node ../../scripts/dev/watch-service.mjs",
    "start": "node dist/main.js",
    "test": "for f in test/*.spec.ts; do npx tsx \"$f\" || exit 1; done && npm run test:payment-recovery",
    "test:payment-recovery": "tsx --tsconfig tsconfig.json --test test/payment-recovery.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@journeyax/business-pack": "*",
    "@journeyax/cache": "*",
    "@journeyax/capability-sdk": "*",
    "@journeyax/database": "*",
    "@journeyax/integration": "*",
    "@journeyax/journey-core": "*",
    "@journeyax/shared-types": "*",
    "@journeyax/ui-cards": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "mongodb": "^7.4.0",
    "openai": "^6.45.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
