{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://journeyax.io/schemas/portfolio-manifest.schema.json",
  "title": "PortfolioManifest",
  "description": "Schema definition for the JourneyAX customer portfolio manifest.",
  "type": "object",
  "required": [
    "version",
    "activePortfolio",
    "parked"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"
    },
    "description": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "activePortfolio": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/TenantEntry"
      }
    },
    "parked": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/TenantEntry"
      }
    },
    "syntheticFixtures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/TenantEntry"
      }
    },
    "syntheticFixtureSuffix": {
      "type": "string"
    },
    "packsRoot": {
      "type": "string"
    }
  },
  "definitions": {
    "TenantEntry": {
      "type": "object",
      "required": [
        "tenantId",
        "displayName",
        "industry",
        "commerceMode",
        "dataResidency"
      ],
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "commerceMode": {
          "type": "string",
          "enum": [
            "quote",
            "cart"
          ]
        },
        "dataResidency": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z0-9]+)?$"
        },
        "migrationPriority": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
