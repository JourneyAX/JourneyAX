# Multi-stage Dockerfile for JourneyAX NestJS Microservices
# This template can be used for any service by passing SERVICE_NAME as build arg
# Based on Metafy AI Dockerfile.template (4-stage pattern)

ARG SERVICE_NAME

# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:20-alpine AS dependencies
ARG SERVICE_NAME

WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY turbo.json ./

# Copy shared packages source (needed for workspace linking)
COPY packages ./packages

# Copy service package.json (needed for dependency resolution)
COPY apps/${SERVICE_NAME}/package.json ./apps/${SERVICE_NAME}/package.json

# Install all dependencies (needed for build)
RUN npm install --legacy-peer-deps --foreground-scripts

# ============================================
# Stage 2: Builder
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependencies from previous stage (includes dev dependencies)
COPY --from=dependencies /app/node_modules ./node_modules

# Copy package files
COPY package*.json ./
COPY turbo.json ./

# Copy shared packages (required for all services)
COPY packages ./packages

# Copy the specific service
ARG SERVICE_NAME
COPY apps/${SERVICE_NAME} ./apps/${SERVICE_NAME}

# Build shared packages first, then the service
# JourneyAX packages: shared-types, database, cache, configurator-core, ingestion, integration
RUN for pkg in shared-types database cache configurator-core ingestion integration; do \
      if [ -d "/app/packages/$pkg" ]; then \
        cd /app/packages/$pkg && npx tsc --build --force 2>/dev/null || true; \
      fi; \
    done

# Fix module resolution
ENV NODE_PATH=/app/node_modules

# Build the specific service
RUN cd /app/apps/${SERVICE_NAME} && npm install --legacy-peer-deps --foreground-scripts && npx tsc --build --force

# ============================================
# Stage 3: Production Dependencies
# ============================================
FROM node:20-alpine AS prod-dependencies

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY turbo.json ./

# Copy packages directory (needed for workspace dependency resolution)
COPY packages ./packages

# Copy ALL workspace package.json files (required for npm workspace resolution)
# Even for microservices, npm workspaces needs to see all workspace package.json files
# to properly resolve and hoist dependencies when using --omit=dev.
# We only copy package.json files (not source code) to minimize image size.
ARG SERVICE_NAME
COPY apps ./apps
RUN find apps -type f ! -name "package.json" -delete && \
    find apps -type d -empty -delete

# Install production dependencies using npm ci for deterministic builds
RUN npm ci --omit=dev --legacy-peer-deps --foreground-scripts && \
    npm cache clean --force

# ============================================
# Stage 4: Production Runtime
# ============================================
FROM node:20-alpine AS production

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

WORKDIR /app

# Copy production dependencies
COPY --from=prod-dependencies --chown=nestjs:nodejs /app/node_modules ./node_modules

# Copy built packages
COPY --from=builder --chown=nestjs:nodejs /app/packages ./packages

# Copy built service
ARG SERVICE_NAME
COPY --from=builder --chown=nestjs:nodejs /app/apps/${SERVICE_NAME}/dist ./apps/${SERVICE_NAME}/dist
COPY --from=builder --chown=nestjs:nodejs /app/apps/${SERVICE_NAME}/package.json ./apps/${SERVICE_NAME}/

# Copy root package.json for workspace resolution
COPY --chown=nestjs:nodejs package*.json ./

# Set environment variables
# Note: PORT will be set by Cloud Run via --port flag, so we don't hardcode it here
ENV NODE_ENV=production \
    SERVICE_NAME=${SERVICE_NAME}

# Switch to non-root user
USER nestjs

# Expose port (Cloud Run sets PORT env variable dynamically)
EXPOSE 8080

# Health check (checks /health endpoint - standard for all services)
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || '8080') + '/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the service
ARG SERVICE_NAME
CMD ["sh", "-c", "node apps/${SERVICE_NAME}/dist/main.js"]
