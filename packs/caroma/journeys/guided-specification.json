{
  "journeyId": "guided_specification",
  "version": "1.0.0",
  "displayName": "Guided Fixture Specification & Quote Flow",
  "description": "Multi-stage flow from space intake to quote finalization.",
  "goals": [
    "identify_space",
    "select_finish",
    "finalize_quote",
    "tapware",
    "fixtures",
    "ensuite",
    "matte black",
    "commercial ensuite",
    "bathroom"
  ],
  "metadata": {
    "triggerIntents": [
      "guided_specification",
      "fixture_specification",
      "ensuite_fixtures",
      "tapware_and_fixtures",
      "commercial_fixtures"
    ]
  },
  "initialStage": "space_intake",
  "stages": {
    "space_intake": {
      "displayName": "Space & Scope Intake",
      "description": "Identifies space type and requirements",
      "requiredFacts": ["spaceType"],
      "allowedCapabilities": ["catalog.search"],
      "capabilityPlan": [
        {
          "toolId": "catalog.search",
          "when": { "factsPresent": ["spaceType"] },
          "producesFacts": ["catalog_results"],
          "sameTurnContinuation": true
        }
      ],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": [
        {
          "allFactsPresent": ["spaceType", "catalog_results"],
          "nextStage": "finish_selection"
        }
      ]
    },
    "finish_selection": {
      "displayName": "Finish & Fixture Selection",
      "description": "Selects tapware finish and fixture parameters",
      "requiredFacts": ["spaceType", "finish"],
      "allowedCapabilities": ["catalog.search", "specification.configure"],
      "capabilityPlan": [
        {
          "toolId": "specification.configure",
          "when": { "factsPresent": ["finish"] },
          "producesFacts": ["spec_configured"],
          "sameTurnContinuation": true
        }
      ],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": [
        {
          "allFactsPresent": ["finish", "spec_configured"],
          "nextStage": "quote_review"
        }
      ]
    },
    "quote_review": {
      "displayName": "Quote Review & Finalization",
      "description": "Reviews specification bill of materials and commits quote",
      "requiredFacts": ["spaceType", "finish"],
      "allowedCapabilities": ["quote.update", "quote.finalize", "salesforce.lead_create"],
      "capabilityPlan": [
        {
          "toolId": "quote.update",
          "when": { "factsPresent": ["spaceType", "finish"] },
          "producesFacts": ["quote_updated"]
        }
      ],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": []
    }
  }
}
