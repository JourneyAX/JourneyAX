{
  "version": "1.0.0",
  "toolDefinitions": [
    {
      "toolId": "catalog.search",
      "version": "1.0.0",
      "displayName": "Catalog Search",
      "description": "Search product catalog with category and preference filtering.",
      "inputSchema": { "query": { "type": "string" }, "category": { "type": "string" } },
      "outputSchema": { "items": { "type": "array" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "item.configure",
      "version": "1.0.0",
      "displayName": "Item Configuration",
      "description": "Configure item options and parameters.",
      "inputSchema": { "itemId": { "type": "string" }, "options": { "type": "object" } },
      "outputSchema": { "configuredItem": { "type": "object" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "cart.update",
      "version": "1.0.0",
      "displayName": "Cart Update",
      "description": "Update cart items and quantities.",
      "inputSchema": { "items": { "type": "array" } },
      "outputSchema": { "cart": { "type": "object" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "cart.checkout",
      "version": "1.0.0",
      "displayName": "Cart Checkout Dispatch",
      "description": "Dispatch customer cart to checkout flow.",
      "inputSchema": { "cartId": { "type": "string" }, "items": { "type": "array" } },
      "outputSchema": { "checkoutUrl": { "type": "string" } },
      "sideEffect": "write",
      "risk": "medium"
    },
    {
      "toolId": "shopify.order_create",
      "version": "1.0.0",
      "displayName": "Shopify Order Create",
      "description": "Creates order in Shopify via Activepieces.",
      "inputSchema": { "items": { "type": "array" } },
      "outputSchema": { "orderId": { "type": "string" } },
      "sideEffect": "transactional",
      "risk": "high"
    }
  ],
  "toolBindings": [
    {
      "tenantId": "abercrombie",
      "environmentId": "production",
      "toolId": "catalog.search",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "catalog-search"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "abercrombie",
      "environmentId": "production",
      "toolId": "item.configure",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "item-configure"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "abercrombie",
      "environmentId": "production",
      "toolId": "cart.update",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "cart-update"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "abercrombie",
      "environmentId": "production",
      "toolId": "cart.checkout",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "activepieces_flow",
        "flowId": "ap_flow_cart_checkout",
        "connectionRef": "conn_cart_checkout",
        "secretRef": "gcp-secret://journeyax-secrets/abercrombie/production/checkout-api-key"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": true,
        "idempotencyRequired": true,
        "timeoutMs": 10000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "abercrombie",
      "environmentId": "production",
      "toolId": "shopify.order_create",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "activepieces_flow",
        "flowId": "ap_flow_anf_shopify_order",
        "connectionRef": "conn_anf_shopify_secret",
        "secretRef": "gcp-secret://journeyax-secrets/abercrombie/production/shopify-api-token"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": true,
        "idempotencyRequired": true,
        "timeoutMs": 8000,
        "retryAttempts": 1
      }
    }
  ],
  "stageBindings": [
    {
      "journeyId": "guided_selection",
      "stageId": "category_selection",
      "tools": [
        { "toolId": "catalog.search" }
      ]
    },
    {
      "journeyId": "guided_selection",
      "stageId": "quantity_selection",
      "tools": [
        { "toolId": "catalog.search" },
        { "toolId": "item.configure" }
      ]
    },
    {
      "journeyId": "guided_selection",
      "stageId": "cart_review",
      "tools": [
        { "toolId": "cart.update" },
        { "toolId": "cart.checkout" },
        { "toolId": "shopify.order_create" }
      ]
    },
    {
      "journeyId": "custom_spec_order",
      "stageId": "spec_intake",
      "tools": [
        { "toolId": "catalog.search" }
      ]
    },
    {
      "journeyId": "custom_spec_order",
      "stageId": "spec_checkout",
      "tools": [
        { "toolId": "cart.update" },
        { "toolId": "cart.checkout" }
      ]
    }
  ]
}
