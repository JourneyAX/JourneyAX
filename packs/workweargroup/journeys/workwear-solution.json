{
  "journeyId": "workwear-solution",
  "version": "1.0.0",
  "displayName": "Workwear Solution Builder",
  "description": "Guides trade customers from trade role identification to a fully budget-compliant pants and boots bundle.",
  "goals": [
    "discover",
    "build_solution",
    "purchase",
    "workwear",
    "apprentice electrician",
    "electrician",
    "summer pants",
    "boots",
    "work boots",
    "pants and boots"
  ],
  "metadata": {
    "triggerIntents": [
      "workwear_solution",
      "workwear",
      "electrician",
      "apprentice_electrician",
      "boots_and_pants",
      "trade_gear"
    ]
  },
  "initialStage": "understand_need",
  "stages": {
    "understand_need": {
      "displayName": "Understand Trade Needs",
      "description": "Capture the customer's trade, required gear items, and price ceiling.",
      "requiredFacts": [
        "occupation",
        "required_item_types",
        "budget"
      ],
      "allowedCapabilities": ["catalog.search"],
      "capabilityPlan": [
        {
          "toolId": "catalog.search",
          "when": { "factsPresent": ["occupation", "required_item_types"] },
          "producesFacts": ["catalog_results"],
          "sameTurnContinuation": true
        }
      ],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": [
        {
          "allFactsPresent": [
            "occupation",
            "required_item_types",
            "catalog_results"
          ],
          "nextStage": "build_solution"
        }
      ]
    },
    "build_solution": {
      "displayName": "Build Compliant Solution",
      "description": "Search catalog, enforce Australian safety compliance and $250 combined budget, and recommend bundle.",
      "requiredFacts": [],
      "allowedCapabilities": [
        "solution.optimize",
        "catalog.search",
        "pricing.validate"
      ],
      "capabilityPlan": [
        {
          "toolId": "solution.optimize",
          "when": { "factsPresent": ["occupation", "required_item_types", "budget"] },
          "producesFacts": ["bundle_recommended"]
        }
      ],
      "blockedCapabilities": ["order.commit"],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": [
        {
          "allFactsPresent": ["solution_bundle_accepted"],
          "nextStage": "purchase"
        }
      ]
    },
    "purchase": {
      "displayName": "Purchase & Commit",
      "description": "Verify final live inventory, generate formal quote or initiate Stripe order.",
      "requiredFacts": ["solution_bundle_accepted"],
      "allowedCapabilities": [
        "pricing.validate",
        "order.commit"
      ],
      "nextDecisionPolicy": "rule-first",
      "exitConditions": []
    }
  }
}
