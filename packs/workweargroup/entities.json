{
  "version": "1.0.0",
  "entities": [
    {
      "entityId": "product",
      "displayName": "Catalog Product",
      "primaryKey": "sku",
      "attributes": [
        { "name": "sku", "type": "string", "required": true },
        { "name": "title", "type": "string", "required": true },
        { "name": "priceCents", "type": "currency", "required": true },
        { "name": "brand", "type": "string", "required": true },
        { "name": "category", "type": "string", "required": true },
        { "name": "safetyStandards", "type": "array" }
      ],
      "searchableAttributes": ["title", "category", "brand", "safetyStandards"]
    },
    {
      "entityId": "bundle_solution",
      "displayName": "Workwear Solution Bundle",
      "primaryKey": "bundleId",
      "attributes": [
        { "name": "bundleId", "type": "string", "required": true },
        { "name": "occupation", "type": "string", "required": true },
        { "name": "items", "type": "array", "required": true },
        { "name": "totalPriceCents", "type": "currency", "required": true }
      ]
    }
  ]
}
