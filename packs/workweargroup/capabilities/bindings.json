{
  "version": "1.0.0",
  "toolDefinitions": [
    {
      "toolId": "catalog.search",
      "version": "1.0.0",
      "displayName": "Catalog Product Search",
      "description": "Searches WWG product catalog with category and feature filtering.",
      "inputSchema": { "query": { "type": "string" }, "category": { "type": "string" } },
      "outputSchema": { "items": { "type": "array" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "solution.optimize",
      "version": "1.0.0",
      "displayName": "Bundle Solution Optimizer",
      "description": "Combines matching items into a bundle that satisfies budget constraints.",
      "inputSchema": { "items": { "type": "array" }, "budget": { "type": "number" } },
      "outputSchema": { "bundle": { "type": "object" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "pricing.validate",
      "version": "1.0.0",
      "displayName": "Deterministic Pricing Validation",
      "description": "Validates live inventory and pricebook totals for items.",
      "inputSchema": { "skus": { "type": "array" } },
      "outputSchema": { "valid": { "type": "boolean" }, "totalCents": { "type": "number" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "crm.create_lead",
      "version": "1.0.0",
      "displayName": "Create Activepieces CRM Lead",
      "description": "Enqueues a qualified sales lead in Activepieces.",
      "inputSchema": { "email": { "type": "string" }, "name": { "type": "string" } },
      "outputSchema": { "leadId": { "type": "string" } },
      "sideEffect": "write",
      "risk": "medium"
    },
    {
      "toolId": "order.commit",
      "version": "1.0.0",
      "displayName": "Commit Order and Open Stripe Session",
      "description": "Authoritatively reserves items and initiates customer payment checkout.",
      "inputSchema": { "quoteId": { "type": "string" } },
      "outputSchema": { "checkoutUrl": { "type": "string" }, "orderId": { "type": "string" } },
      "sideEffect": "transactional",
      "risk": "high"
    }
  ],
  "toolBindings": [
    {
      "tenantId": "workweargroup",
      "environmentId": "production",
      "toolId": "order.commit",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "order.commit"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": true,
        "idempotencyRequired": true,
        "timeoutMs": 10000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "workweargroup",
      "environmentId": "production",
      "toolId": "catalog.search",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "catalog.search"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "workweargroup",
      "environmentId": "production",
      "toolId": "solution.optimize",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "solution.optimize"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "workweargroup",
      "environmentId": "production",
      "toolId": "pricing.validate",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "pricing.validate"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "workweargroup",
      "environmentId": "production",
      "toolId": "crm.create_lead",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "activepieces_flow",
        "flowId": "ap_lead_flow_wwg"
      },
      "policy": {
        "requiredRole": "customer",
        "requiresConfirmation": true,
        "idempotencyRequired": true,
        "timeoutMs": 15000,
        "retryAttempts": 0
      }
    }
  ],
  "stageBindings": [
    {
      "journeyId": "workwear-solution",
      "stageId": "understand_need",
      "tools": [
        { "toolId": "catalog.search" }
      ]
    },
    {
      "journeyId": "workwear-solution",
      "stageId": "build_solution",
      "tools": [
        { "toolId": "solution.optimize" },
        { "toolId": "catalog.search" },
        { "toolId": "pricing.validate" }
      ]
    },
    {
      "journeyId": "workwear-solution",
      "stageId": "purchase",
      "tools": [
        { "toolId": "pricing.validate" },
        { "toolId": "crm.create_lead" }
      ]
    }
  ]
}
