{
  "version": "1.0.0",
  "entities": [
    {
      "entityId": "trade_project",
      "displayName": "Trade Project",
      "description": "Trade project scope, trade category, and sizing",
      "primaryKey": "projectId",
      "attributes": [
        { "name": "tradeCategory", "type": "string", "required": true },
        { "name": "dimensions", "type": "string", "required": false },
        { "name": "complianceStandard", "type": "string", "required": false }
      ]
    },
    {
      "entityId": "trade_quote",
      "displayName": "Trade Quote",
      "description": "PlaceMakers formal trade estimation quote",
      "primaryKey": "quoteId",
      "attributes": [
        { "name": "quoteId", "type": "string", "required": true },
        { "name": "tradeCategory", "type": "string", "required": true },
        { "name": "totalNzd", "type": "number", "required": true }
      ]
    }
  ]
}
