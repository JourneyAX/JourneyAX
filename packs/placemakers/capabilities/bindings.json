{
  "version": "1.0.0",
  "toolDefinitions": [
    {
      "toolId": "catalog.search",
      "version": "1.0.0",
      "displayName": "PlaceMakers Catalog Search",
      "description": "Search trade building materials and hardware.",
      "inputSchema": {
        "properties": {
          "query": { "type": "string" }
        }
      },
      "outputSchema": {
        "properties": {
          "items": { "type": "array" }
        }
      },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "knowledge.search",
      "version": "1.0.0",
      "displayName": "Technical Documentation & Compliance Search",
      "description": "Search BRANZ and NZBC installation guides.",
      "inputSchema": {
        "properties": {
          "query": { "type": "string" }
        }
      },
      "outputSchema": {
        "properties": {
          "documents": { "type": "array" }
        }
      },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "branch.stock_check",
      "version": "1.0.0",
      "displayName": "Check 60-Minute Branch Stock",
      "description": "Checks real-time inventory at Mt Wellington, Cook St, and national branches.",
      "inputSchema": {
        "properties": {
          "sku": { "type": "string" },
          "branch": { "type": "string" }
        }
      },
      "outputSchema": {
        "properties": {
          "inStock": { "type": "boolean" },
          "quantity": { "type": "number" }
        }
      },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "trade.quote_create",
      "version": "1.0.0",
      "displayName": "Create Trade BOM Quote",
      "description": "Generates structured trade quote with trade discount pricing.",
      "inputSchema": {
        "properties": {
          "items": { "type": "array" }
        }
      },
      "outputSchema": {
        "properties": {
          "quoteId": { "type": "string" }
        }
      },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "sap.quote_sync",
      "version": "1.0.0",
      "displayName": "Sync Quote to SAP ERP",
      "description": "Syncs trade quote to PlaceMakers SAP ERP via Activepieces flow.",
      "inputSchema": {
        "properties": {
          "quoteId": { "type": "string" }
        }
      },
      "outputSchema": {
        "properties": {
          "erpReference": { "type": "string" }
        }
      },
      "sideEffect": "write",
      "risk": "medium"
    },
    {
      "toolId": "order.commit",
      "version": "1.0.0",
      "displayName": "Commit Trade Order",
      "description": "Places binding trade order against trade credit account.",
      "inputSchema": {
        "properties": {
          "quoteId": { "type": "string" }
        }
      },
      "outputSchema": {
        "properties": {
          "orderId": { "type": "string" }
        }
      },
      "sideEffect": "transactional",
      "risk": "high"
    }
  ],
  "toolBindings": [
    {
      "tenantId": "placemakers",
      "environmentId": "production",
      "toolId": "catalog.search",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "catalog.search"
      },
      "inputMapping": {
        "query": "tradeCategory"
      },
      "outputFactMapping": {
        "catalog_results": "items"
      },
      "timeoutMs": 10000
    },
    {
      "tenantId": "placemakers",
      "environmentId": "production",
      "toolId": "knowledge.search",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "knowledge.search"
      },
      "inputMapping": {
        "query": "tradeCategory"
      },
      "outputFactMapping": {
        "knowledge_verified": "verified"
      },
      "timeoutMs": 10000
    },
    {
      "tenantId": "placemakers",
      "environmentId": "production",
      "toolId": "branch.stock_check",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "branch.stock_check"
      },
      "inputMapping": {
        "branch": "branch"
      },
      "outputFactMapping": {
        "stock_confirmed": "inStock"
      },
      "timeoutMs": 10000
    },
    {
      "tenantId": "placemakers",
      "environmentId": "production",
      "toolId": "trade.quote_create",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "trade.quote_create"
      },
      "outputFactMapping": {
        "quote_generated": "quoteId",
        "bom_confirmed": "confirmed",
        "package_selected": "packageId"
      },
      "timeoutMs": 10000
    },
    {
      "tenantId": "placemakers",
      "environmentId": "production",
      "toolId": "sap.quote_sync",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "activepieces_flow",
        "flowId": "ap_flow_pm_sap_quote"
      },
      "outputFactMapping": {
        "erp_synced": "erpReference"
      },
      "timeoutMs": 15000
    },
    {
      "tenantId": "placemakers",
      "environmentId": "production",
      "toolId": "order.commit",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "order.commit"
      },
      "outputFactMapping": {
        "order_submitted": "orderId"
      },
      "timeoutMs": 10000
    }
  ],
  "stageBindings": [
    {
      "journeyId": "placemakers_deck_estimator",
      "stageId": "sizing",
      "tools": [
        {
          "toolId": "catalog.search",
          "inputMapping": {
            "query": "deck_dimensions"
          },
          "outputFactMapping": {
            "catalog_results": "items"
          }
        }
      ]
    },
    {
      "journeyId": "placemakers_deck_estimator",
      "stageId": "materials_spec",
      "tools": [
        {
          "toolId": "trade.quote_create",
          "inputMapping": {},
          "outputFactMapping": {
            "quote_generated": "quoteId"
          }
        }
      ]
    },
    {
      "journeyId": "placemakers_laundry_makeover",
      "stageId": "discovery",
      "tools": [
        {
          "toolId": "catalog.search",
          "inputMapping": {
            "query": "room_dimensions"
          },
          "outputFactMapping": {
            "catalog_results": "items"
          }
        }
      ]
    },
    {
      "journeyId": "placemakers_laundry_makeover",
      "stageId": "specification",
      "tools": [
        {
          "toolId": "trade.quote_create",
          "inputMapping": {},
          "outputFactMapping": {
            "package_selected": "packageId"
          }
        }
      ]
    },
    {
      "journeyId": "placemakers_trade_quote",
      "stageId": "project_intake",
      "tools": [
        {
          "toolId": "knowledge.search",
          "inputMapping": {
            "query": "tradeCategory"
          },
          "outputFactMapping": {
            "knowledge_verified": "verified"
          }
        }
      ]
    },
    {
      "journeyId": "placemakers_trade_quote",
      "stageId": "bom_assembly",
      "tools": [
        {
          "toolId": "trade.quote_create",
          "inputMapping": {},
          "outputFactMapping": {
            "bom_confirmed": "confirmed"
          }
        }
      ]
    }
  ]
}
