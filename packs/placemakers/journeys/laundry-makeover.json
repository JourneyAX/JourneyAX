{
  "journeyId": "placemakers_laundry_makeover",
  "version": "1.0.0",
  "displayName": "Complete 5-Trade Laundry Solution",
  "description": "Multi-trade laundry room solution covering cabinetry, tub, tapware, and wet-wall waterproofing.",
  "goals": ["room_discovery", "trade_specification", "solution_bundle", "laundry makeover", "supertub", "laundry solution"],
  "metadata": {
    "triggerIntents": ["laundry_makeover", "laundry", "supertub", "laundry_solution"]
  },
  "initialStage": "discovery",
  "stages": {
    "discovery": {
      "displayName": "Room Discovery",
      "description": "Capture room dimensions and style preference.",
      "requiredFacts": ["room_dimensions"],
      "allowedCapabilities": ["catalog.search"],
      "capabilityPlan": [
        {
          "toolId": "catalog.search",
          "when": { "factsPresent": ["room_dimensions"] },
          "producesFacts": ["catalog_results"]
        }
      ],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": [
        { "allFactsPresent": ["room_dimensions", "catalog_results"], "nextStage": "specification" }
      ]
    },
    "specification": {
      "displayName": "Multi-Trade Specification",
      "description": "Specify compliant cabinetry, tub, and GIB Aqualine wet-wall linings.",
      "requiredFacts": [],
      "allowedCapabilities": ["catalog.search", "knowledge.search", "trade.quote_create"],
      "capabilityPlan": [
        {
          "toolId": "trade.quote_create",
          "when": { "factsMissing": ["package_selected"] },
          "producesFacts": ["package_selected"]
        }
      ],
      "nextDecisionPolicy": "dependency-first",
      "exitConditions": [
        { "allFactsPresent": ["package_selected"], "nextStage": "bundle_review" }
      ]
    },
    "bundle_review": {
      "displayName": "Package Review & Pickup",
      "description": "Confirm 60-minute branch pickup or trade dispatch.",
      "requiredFacts": ["package_selected"],
      "allowedCapabilities": ["branch.stock_check", "order.commit"],
      "capabilityPlan": [
        {
          "toolId": "branch.stock_check",
          "when": { "factsPresent": ["package_selected"] },
          "producesFacts": ["stock_confirmed"]
        }
      ],
      "nextDecisionPolicy": "rule-first",
      "exitConditions": []
    }
  }
}
