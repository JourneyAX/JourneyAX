{
  "version": "1.0.0",
  "toolDefinitions": [
    {
      "toolId": "scoping.estimate_effort",
      "version": "1.0.0",
      "displayName": "Effort & Sprint Estimator",
      "description": "Calculates sprint allocation, team composition, and cost estimates from scoping facts.",
      "inputSchema": { "scopeItems": { "type": "array" }, "cloudPlatform": { "type": "string" } },
      "outputSchema": { "sprints": { "type": "number" }, "estimatedCostUsd": { "type": "number" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "scoping.search_case_studies",
      "version": "1.0.0",
      "displayName": "Case Studies & Architectural Blueprints",
      "description": "Finds relevant Royal Cyber case studies and reference patterns.",
      "inputSchema": { "domain": { "type": "string" }, "cloud": { "type": "string" } },
      "outputSchema": { "caseStudies": { "type": "array" } },
      "sideEffect": "read",
      "risk": "low"
    },
    {
      "toolId": "hubspot.create_deal",
      "version": "1.0.0",
      "displayName": "Create HubSpot Deal",
      "description": "Synchronizes client scoping details to HubSpot CRM via Activepieces.",
      "inputSchema": { "clientEmail": { "type": "string" }, "dealValueUsd": { "type": "number" } },
      "outputSchema": { "dealId": { "type": "string" } },
      "sideEffect": "write",
      "risk": "medium"
    },
    {
      "toolId": "jira.create_scoping_epic",
      "version": "1.0.0",
      "displayName": "Create Jira Scoping Epic",
      "description": "Creates an architecture epic in Jira with deliverable tickets via Activepieces.",
      "inputSchema": { "projectKey": { "type": "string" }, "summary": { "type": "string" } },
      "outputSchema": { "epicKey": { "type": "string" } },
      "sideEffect": "write",
      "risk": "medium"
    }
  ],
  "toolBindings": [
    {
      "tenantId": "royalcyber",
      "environmentId": "production",
      "toolId": "scoping.estimate_effort",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "scoping.estimate_effort"
      },
      "policy": {
        "requiredRole": "consultant",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "royalcyber",
      "environmentId": "production",
      "toolId": "scoping.search_case_studies",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "native_capability",
        "nativeHandler": "scoping.search_case_studies"
      },
      "policy": {
        "requiredRole": "consultant",
        "requiresConfirmation": false,
        "idempotencyRequired": false,
        "timeoutMs": 5000,
        "retryAttempts": 0
      }
    },
    {
      "tenantId": "royalcyber",
      "environmentId": "production",
      "toolId": "hubspot.create_deal",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "activepieces_flow",
        "flowId": "ap_flow_rc_hubspot_deal"
      },
      "policy": {
        "requiredRole": "partner",
        "requiresConfirmation": true,
        "idempotencyRequired": true,
        "timeoutMs": 10000,
        "retryAttempts": 1
      }
    },
    {
      "tenantId": "royalcyber",
      "environmentId": "production",
      "toolId": "jira.create_scoping_epic",
      "bindingVersion": "1.0.0",
      "executor": {
        "type": "activepieces_flow",
        "flowId": "ap_flow_rc_jira_epic"
      },
      "policy": {
        "requiredRole": "partner",
        "requiresConfirmation": true,
        "idempotencyRequired": true,
        "timeoutMs": 10000,
        "retryAttempts": 1
      }
    }
  ],
  "stageBindings": [
    {
      "journeyId": "consulting-intake",
      "stageId": "intake",
      "tools": [
        { "toolId": "scoping.search_case_studies" }
      ]
    },
    {
      "journeyId": "consulting-intake",
      "stageId": "architecture_scoping",
      "tools": [
        { "toolId": "scoping.estimate_effort" },
        { "toolId": "scoping.search_case_studies" }
      ]
    },
    {
      "journeyId": "consulting-intake",
      "stageId": "sow_draft",
      "tools": [
        { "toolId": "scoping.estimate_effort" },
        { "toolId": "hubspot.create_deal" },
        { "toolId": "jira.create_scoping_epic" }
      ]
    }
  ]
}
