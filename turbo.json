{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GATEWAY_URL",
    "AUTH_SERVICE_URL",
    "PRODUCT_SERVICE_URL",
    "AGENT_SERVICE_URL",
    "PROJECT_API",
    "PROJECT_SERVICE_URL",
    "ORG_SERVICE_URL",
    "ANALYTICS_SERVICE_URL",
    "NEXT_PUBLIC_GATEWAY_URL",
    "NEXT_PUBLIC_AUTH_API",
    "NEXT_PUBLIC_GATEWAY_API",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "MONGODB_URI",
    "INTERNAL_API_KEY",
    "DEFAULT_PROJECT_ID",
    "AUTH_DEV_BYPASS",
    "JOURNEY_RUNTIME_SERVICE_URL",
    "JOURNEY_RUNTIME_URL",
    "RUNTIME_SERVICE_URL",
    "JOURNEY_RUNTIME_PORT",
    "WHATSAPP_VERIFY_TOKEN",
    "WHATSAPP_APP_SECRET",
    "NODE_ENV",
    "MONGODB_DB_NAME",
    "JOURNEYAX_ENV_FILE",
    "GATEWAY_ASSERTION_SECRET",
    "JAX_IQ_ENABLED",
    "JAX_IQ_PORT",
    "JAX_IQ_SERVICE_URL",
    "JAX_IQ_SIGNING_SECRET",
    "JAX_IQ_CONNECTOR_SIGNING_SECRET",
    "JAX_IQ_MONGODB_URI",
    "JAX_IQ_MONGODB_DB",
    "CONNECTOR_MCP_SERVERS",
    "CONNECTOR_MCP_BASE_URL",
    "CONNECTOR_SECRET_*",
    "ERP_DEMO_*",
    "COMMERCE_ENVIRONMENT",
    "STOREFRONT_URL",
    "STOREFRONT_PUBLIC_ORIGIN",
    "JOURNEYAX_CONNECTORS_ENV_FILE",
    "REAL_CONNECTORS_PORT",
    "REAL_CONNECTORS_ENVIRONMENT",
    "JAX_IQ_SERVICE_PORT",
    "GATEWAY_PORT",
    "AUTH_SERVICE_PORT",
    "PROJECT_SERVICE_PORT",
    "PRODUCT_SERVICE_PORT",
    "AGENT_SERVICE_PORT",
    "ORG_SERVICE_PORT",
    "ANALYTICS_SERVICE_PORT",
    "NEXT_PUBLIC_COMMERCE_ENVIRONMENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "start": {
      "persistent": true
    }
  }
}
