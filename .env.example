# ─────────────────────────────────────────────────────────────────────────
# JourneyAX environment
#
# Copy to .env.local and fill in. Both .env and .env.local are gitignored.
#
# GOTCHA: Next expands $VAR inside these files. Any value containing a
# literal $ — connection strings, generated secrets — is silently mangled.
# Escape it as $$, or quote the value.
# ─────────────────────────────────────────────────────────────────────────

# ── Required for / (the Caroma journey) only ────────────────────────────
# Every other journey runs on mock data and needs neither of these.
OPENAI_API_KEY=""
# The vector_index must be created in the Atlas UI — ensureIndexes() only
# creates the scalar indexes.
MONGODB_URI=""

# ── Staff authentication (/csr, /fit) ───────────────────────────────────
# At least 32 characters. The app REFUSES TO START in production without it,
# because a predictable secret lets anyone mint a staff session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Read-only account directory. Comma-separated: username:role:hash
# Generate entries with: npx tsx src/scripts/make-user.ts add <user> <csr|admin>
# Password changes, MFA and recovery codes are IMPOSSIBLE against this — the
# routes return 501 rather than pretending to succeed.
JOURNEYAX_USERS=""

# Writable account store. Takes precedence over JOURNEYAX_USERS and enables
# password changes, MFA and recovery codes.
# CONTAINS PASSWORD HASHES AND TOTP SECRETS — treat as credential material.
# Single-instance only: two processes writing it will clobber each other.
JOURNEYAX_USER_STORE="./data/users.json"

# ── Ingestion scripts only ──────────────────────────────────────────────
# Not used by the app. Needed for `npx tsx src/scripts/ingest.ts --crawl`.
FIRECRAWL_API_KEY=""
