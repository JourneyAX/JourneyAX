# Local COMS-derived reorder data
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=journeyax_poc
MONGODB_REORDER_COLLECTION=coms_orders
REORDER_DATA_API_PORT=3101
REORDER_DATA_API_URL=http://127.0.0.1:3101

# Coach access
# Generate a private value of at least 32 characters. Never commit the real value.
COACH_LINK_SECRET=replace-with-a-long-random-secret
COACH_LINK_BASE_URL=http://localhost:3100
REORDER_DEMO_MODE=false
# Production example: [{"id":"coach-1","email":"coach@school.edu","name":"Coach Name","role":"coach","schools":["School Name"]}]
REORDER_AUTHORIZED_USERS_JSON=[]

# Optional email delivery. Without these, development displays the code locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
