{
  "connectorId": "bloomreach",
  "title": "Bloomreach (sample)",
  "standsInFor": "Bloomreach: site search and product discovery",
  "description": "Site search over the product catalogue, search suggestions and popular searches.",
  "minimums": {
    "catalog": 40,
    "queries": 25
  },
  "tools": [
    {
      "name": "search",
      "description": "Search the catalogue the way the shop's site search does. Best matches first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "What the shopper typed."
          },
          "department": {
            "type": "string",
            "description": "Optional department."
          },
          "brand": {
            "type": "string",
            "description": "Optional brand."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "query": "$first:queries.query"
      },
      "op": {
        "kind": "find",
        "collection": "catalog",
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "text": {
          "arg": "query",
          "fields": [
            {
              "field": "title",
              "weight": 4
            },
            {
              "field": "brand",
              "weight": 3
            },
            {
              "field": "keywords",
              "weight": 3
            },
            {
              "field": "categoryPath",
              "weight": 2
            },
            {
              "field": "department",
              "weight": 1
            }
          ],
          "mode": "any"
        },
        "filters": [
          {
            "arg": "department",
            "field": "department"
          },
          {
            "arg": "brand",
            "field": "brand"
          }
        ],
        "sort": {
          "field": "title"
        }
      }
    },
    {
      "name": "suggestions",
      "description": "Suggestions for what a shopper has started to type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "description": "The first letters or words typed."
          }
        },
        "required": [
          "prefix"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "prefix": "dec"
      },
      "op": {
        "kind": "find",
        "collection": "queries",
        "limit": {
          "arg": "limit",
          "default": 8,
          "max": 15
        },
        "text": {
          "arg": "prefix",
          "fields": [
            {
              "field": "query",
              "weight": 1
            }
          ]
        },
        "sort": {
          "field": "count",
          "order": "desc"
        },
        "select": [
          "query",
          "resultCount"
        ]
      }
    },
    {
      "name": "popular_searches",
      "description": "The searches shoppers make most, with how many products each finds.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {},
      "op": {
        "kind": "find",
        "collection": "queries",
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "sort": {
          "field": "count",
          "order": "desc"
        }
      }
    }
  ]
}
