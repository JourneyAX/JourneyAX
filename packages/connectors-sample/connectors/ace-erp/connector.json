{
  "connectorId": "ace-erp",
  "title": "SAP ERP (sample)",
  "standsInFor": "SAP ERP: stock, trade prices, deliveries and account balances",
  "description": "Stock by branch, trade prices, deliveries and account balances.",
  "minimums": {
    "branches": 25,
    "stock": 100,
    "deliveries": 25,
    "price_list": 25,
    "account_balances": 25,
    "invoices": 7,
    "consignments": 40,
    "consignment_lines": 93,
    "tracking_events": 93
  },
  "tools": [
    {
      "name": "stock_by_branch",
      "description": "Stock on hand for a product, branch by branch. Narrow it to one branch with branchCode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The product SKU."
          },
          "branchCode": {
            "type": "string",
            "description": "Optional branch code."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "sku"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "sku": "$first:stock.sku"
      },
      "op": {
        "kind": "find",
        "collection": "stock",
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "filters": [
          {
            "arg": "sku",
            "field": "sku"
          },
          {
            "arg": "branchCode",
            "field": "branchCode"
          }
        ],
        "sort": {
          "field": "available",
          "order": "desc"
        }
      }
    },
    {
      "name": "trade_price",
      "description": "The retail price and the trade prices by tier (bronze, silver, gold) for a product.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "The product SKU."
          }
        },
        "required": [
          "sku"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "sku": "$first:price_list.sku"
      },
      "op": {
        "kind": "get",
        "collection": "price_list",
        "key": "sku",
        "arg": "sku"
      }
    },
    {
      "name": "delivery_status",
      "description": "Where a delivery is. Give the delivery id or the ERP's own order number (ORD-nnnnnn).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deliveryId": {
            "type": "string",
            "description": "The delivery id, for example DEL-30001."
          },
          "orderId": {
            "type": "string",
            "description": "The ERP's own order number, for example ORD-100045. The shop numbers orders differently: its OPP-nnnn number or its long order id will not be found here."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "deliveryId": "$first:deliveries.deliveryId"
      },
      "op": {
        "kind": "get",
        "collection": "deliveries",
        "key": "deliveryId",
        "arg": "deliveryId",
        "altKeys": [
          {
            "key": "orderId",
            "arg": "orderId"
          }
        ]
      }
    },
    {
      "name": "list_deliveries",
      "description": "The deliveries of one trade account, newest first. Give the account id; optionally only one status (scheduled, out_for_delivery, delivered, failed_attempt).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "The account id, for example ACC-0028."
          },
          "status": {
            "type": "string",
            "description": "Optional: only deliveries in this status."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "accountId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "accountId": "ACC-0028"
      },
      "op": {
        "kind": "find",
        "collection": "deliveries",
        "filters": [
          {
            "arg": "accountId",
            "field": "accountId"
          },
          {
            "arg": "status",
            "field": "status"
          }
        ],
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "sort": {
          "field": "scheduledDate",
          "order": "desc"
        }
      }
    },
    {
      "name": "list_consignments",
      "description": "The consignments of one order or one trade account, newest first: consignment number, order number, delivery or collection, branch, trip, status and when it was made. Give an order number or an account id; optionally only one status (planned, picked, out_for_delivery, delivered, failed_attempt, returned, collected).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "string",
            "description": "The order number, for example ORD-100034."
          },
          "accountId": {
            "type": "string",
            "description": "The account id, for example ACC-0004."
          },
          "status": {
            "type": "string",
            "description": "Optional: only consignments with this status (planned, picked, out_for_delivery, delivered, failed_attempt, returned, collected)."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "orderNumber": "$first:consignments.orderNumber"
      },
      "op": {
        "kind": "find",
        "collection": "consignments",
        "filters": [
          {
            "arg": "orderNumber",
            "field": "orderNumber"
          },
          {
            "arg": "accountId",
            "field": "accountId"
          },
          {
            "arg": "status",
            "field": "status"
          }
        ],
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "sort": {
          "field": "createdAt",
          "order": "desc"
        }
      }
    },
    {
      "name": "get_consignment",
      "description": "One consignment with its order number, delivery or collection, branch, trip, status and date. Give the consignment number, for example CON-50001.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "consignmentId": {
            "type": "string",
            "description": "The consignment number, for example CON-50001."
          }
        },
        "required": [
          "consignmentId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "consignmentId": "$first:consignments.consignmentId"
      },
      "op": {
        "kind": "get",
        "collection": "consignments",
        "key": "consignmentId",
        "arg": "consignmentId"
      }
    },
    {
      "name": "list_consignment_lines",
      "description": "What is on consignments, line by line: the order line, the product code and the quantity. Give a consignment number or an order number; optionally only one product code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "string",
            "description": "The order number, for example ORD-100042."
          },
          "consignmentId": {
            "type": "string",
            "description": "The consignment number, for example CON-50002."
          },
          "sku": {
            "type": "string",
            "description": "Optional: only lines for this product SKU."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "consignmentId": "$first:consignment_lines.consignmentId"
      },
      "op": {
        "kind": "find",
        "collection": "consignment_lines",
        "filters": [
          {
            "arg": "orderNumber",
            "field": "orderNumber"
          },
          {
            "arg": "consignmentId",
            "field": "consignmentId"
          },
          {
            "arg": "sku",
            "field": "sku"
          }
        ],
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "sort": {
          "field": "consignmentId",
          "order": "asc"
        }
      }
    },
    {
      "name": "list_tracking_events",
      "description": "The events of a consignment (picked, out_for_delivery, delivered, failed_attempt with the reason, returned, collected) or of a trip (loaded, dispatched), oldest first, with the time and, on a delivery or a collection, who took the goods and the proof reference. Give a consignment number or a trip number, for example DEL-30002.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "consignmentId": {
            "type": "string",
            "description": "The consignment number, for example CON-50002."
          },
          "shipmentId": {
            "type": "string",
            "description": "The trip, which is the delivery number, for example DEL-30002."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "consignmentId": "$firstWith:tracking_events.consignmentId"
      },
      "op": {
        "kind": "find",
        "collection": "tracking_events",
        "filters": [
          {
            "arg": "consignmentId",
            "field": "consignmentId"
          },
          {
            "arg": "shipmentId",
            "field": "shipmentId"
          }
        ],
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "sort": {
          "field": "at",
          "order": "asc"
        }
      }
    },
    {
      "name": "find_account",
      "description": "Find a trade account by part of its name: returns its ERP account number (such as ACC-0028), its name, price tier and payment terms. Use the number with the other tools. No balances.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Part of the account name."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 10).",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "query": "Talbot"
      },
      "op": {
        "kind": "find",
        "collection": "account_balances",
        "text": {
          "arg": "query",
          "fields": [
            {
              "field": "name",
              "weight": 3
            },
            {
              "field": "accountId",
              "weight": 2
            }
          ],
          "mode": "all"
        },
        "limit": {
          "arg": "limit",
          "default": 5,
          "max": 10
        },
        "sort": {
          "field": "name",
          "order": "asc"
        },
        "select": [
          "accountId",
          "name",
          "tier",
          "terms"
        ]
      }
    },
    {
      "name": "account_balance",
      "description": "The balance, credit limit and overdue amount of a trade account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "The account id, for example ACC-0001."
          }
        },
        "required": [
          "accountId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "accountId": "$first:account_balances.accountId"
      },
      "op": {
        "kind": "get",
        "collection": "account_balances",
        "key": "accountId",
        "arg": "accountId"
      }
    },
    {
      "name": "list_account_balances",
      "description": "Trade accounts with their balance, credit limit and overdue amount, most overdue first. Give minOverdue to list only the accounts overdue by at least that much.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "minOverdue": {
            "type": "number",
            "description": "Only accounts overdue by at least this much, for example 0.01 for every overdue account."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 30).",
            "minimum": 1,
            "maximum": 30
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "minOverdue": 0.01
      },
      "op": {
        "kind": "find",
        "collection": "account_balances",
        "filters": [
          {
            "arg": "minOverdue",
            "field": "overdue",
            "match": "gte"
          }
        ],
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 30
        },
        "sort": {
          "field": "overdue",
          "order": "desc"
        }
      }
    },
    {
      "name": "list_branches",
      "description": "List branches, or find one by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional words from the branch name."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "query": "dunedin"
      },
      "op": {
        "kind": "find",
        "collection": "branches",
        "limit": {
          "arg": "limit",
          "default": 25,
          "max": 25
        },
        "text": {
          "arg": "query",
          "fields": [
            {
              "field": "name",
              "weight": 3
            },
            {
              "field": "code",
              "weight": 3
            }
          ]
        },
        "sort": {
          "field": "name"
        }
      }
    },
    {
      "name": "find_invoices",
      "description": "The invoices of one trade account, newest first: invoice number, order number, issue and due dates, status and totals, without the lines. Give the account id; optionally only one status (open, part_paid, paid, overdue) or one order number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "The account id, for example ACC-0028."
          },
          "status": {
            "type": "string",
            "description": "Optional: only invoices in this status (open, part_paid, paid, overdue)."
          },
          "orderNumber": {
            "type": "string",
            "description": "Optional: only the invoice for this order number, for example ORD-100033."
          },
          "limit": {
            "type": "integer",
            "description": "How many to return (up to 25).",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "accountId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "accountId": "$first:invoices.accountId"
      },
      "op": {
        "kind": "find",
        "collection": "invoices",
        "filters": [
          {
            "arg": "accountId",
            "field": "accountId"
          },
          {
            "arg": "status",
            "field": "status"
          },
          {
            "arg": "orderNumber",
            "field": "commercetoolsOrderNumber"
          }
        ],
        "limit": {
          "arg": "limit",
          "default": 10,
          "max": 25
        },
        "sort": {
          "field": "issuedAt",
          "order": "desc"
        },
        "select": [
          "invoiceId",
          "accountId",
          "commercetoolsOrderNumber",
          "orderId",
          "deliveryId",
          "issuedAt",
          "dueAt",
          "dueNote",
          "status",
          "currency",
          "subtotal",
          "gst",
          "total",
          "paidAmount",
          "sample"
        ]
      }
    },
    {
      "name": "get_invoice",
      "description": "One invoice with its lines, GST and total. Give the invoice id, for example INV-40001.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "description": "The invoice id, for example INV-40001."
          }
        },
        "required": [
          "invoiceId"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "example": {
        "invoiceId": "$first:invoices.invoiceId"
      },
      "op": {
        "kind": "get",
        "collection": "invoices",
        "key": "invoiceId",
        "arg": "invoiceId"
      }
    }
  ]
}
