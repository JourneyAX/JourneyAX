# The real connectors' settings. Copy this file to .env.connectors in the project's top folder (it is ignored by git) and fill in
# what you have. Nothing here is read by the chat, the gateway or the web app: only the real connector server reads this file, so
# the vendors' credentials exist in one process only.
#
#   npx tsx --env-file=.env.connectors packages/connectors-real/src/cli.ts
#
# A connector with blanks is still served, and says it is not connected yet. Fill in one at a time.

# ── This server ─────────────────────────────────────────────────────────────────────────────────
# The key the chat's runtime presents to this server. Make it long and random. The runtime reads the same value as
# CONNECTOR_SECRET_REAL_CONNECTORS_KEY in its own .env.
REAL_CONNECTORS_API_KEY=
REAL_CONNECTORS_PORT=4020
# The vendor accounts below belong to ONE shop, so list only that shop here. Adding another tenant would let it use this shop's
# commercetools, Salesforce, Google Analytics and Power BI. A second shop gets its own server with its own file.
REAL_CONNECTORS_TENANTS=placemakers

# ── commercetools ───────────────────────────────────────────────────────────────────────────────
# Merchant Center > Settings > Developer settings > Create new API client. Give it the scopes view_products, view_orders and
# manage_orders (carts are kept under the orders scopes) and nothing more.
COMMERCETOOLS_PROJECT_KEY=
COMMERCETOOLS_CLIENT_ID=
COMMERCETOOLS_CLIENT_SECRET=
# The region in the API client's host, for example australia-southeast1.gcp, europe-west1.gcp or us-central1.gcp
COMMERCETOOLS_REGION=
# optional
# COMMERCETOOLS_LOCALE=en
# COMMERCETOOLS_CURRENCY=NZD
# COMMERCETOOLS_BRAND_ATTRIBUTE=brand
# COMMERCETOOLS_ACCOUNT_KIND=customer

# ── Salesforce ──────────────────────────────────────────────────────────────────────────────────
# Setup > App Manager > New External Client App (or Connected App): switch on the client credentials flow and choose a "run as" user
# whose permissions are as small as the job allows (read accounts, contacts and cases; create cases).
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# For a first quick try you can use a short-lived token instead of the two lines above (from `sf org display`):
# SALESFORCE_ACCESS_TOKEN=
# optional: custom fields on Account that hold a customer tier and a home branch code, and the Origin of cases the assistant opens
# SALESFORCE_TIER_FIELD=
# SALESFORCE_BRANCH_FIELD=
# SALESFORCE_CASE_ORIGIN=Web

# ── Google Analytics 4 ──────────────────────────────────────────────────────────────────────────
# Admin > Property details gives the number. In Google Cloud, switch on the "Google Analytics Data API", make a service account, make a
# JSON key for it, and add the service account's email to the property (Admin > Property access management) as Viewer.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_FILE=

# ── Power BI ────────────────────────────────────────────────────────────────────────────────────
# A Microsoft Entra app registration with a client secret. In the Power BI admin portal switch on "Allow service principals to use
# Power BI APIs" and "Dataset Execute Queries REST API", and add the app to the workspace (Viewer, with Build on the dataset).
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
# The figures the assistant may read, each a dataset and a DAX query (see the top of src/connectors/power-bi.ts for the format)
POWERBI_REPORTS_FILE=
