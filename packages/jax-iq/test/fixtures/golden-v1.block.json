  "permissionRules": [
    {
      "ruleId": "pr-account-credit-see", "mode": "see",
      "target": { "thing": "Account", "facts": ["Account.balance", "Account.creditLimit", "Account.overdue", "Account.lastPaid"] },
      "who": [{ "audience": "staff", "groups": ["finance", "sales-managers", "leadership"] }],
      "note": "A shopper or another customer never sees these."
    },
    {
      "ruleId": "pr-account-basic-see", "mode": "see",
      "target": { "thing": "Account", "facts": ["Account.name", "Account.tier", "Account.terms", "Account.status", "Account.homeBranchCode", "Account.openOrderCount"] },
      "who": [{ "audience": "staff", "groups": [] }]
    },
    {
      "ruleId": "pr-ticket-see", "mode": "see",
      "target": { "thing": "Ticket" },
      "who": [{ "audience": "staff", "groups": ["customer-service", "sales", "sales-managers", "leadership"] }]
    },
    {
      "ruleId": "pr-ticket-change", "mode": "change",
      "target": { "thing": "Ticket" },
      "who": [{ "audience": "staff", "groups": ["customer-service"] }],
      "writeTools": [{ "connectorId": "zendesk", "tool": "add_ticket_note" }],
      "note": "Only customer service writes to a ticket; leadership changes nothing."
    }
  ],
  "signalRules": [
    {
      "signalId": "sig-credit-use", "name": "Credit use", "meaning": "How much of the credit limit the balance uses.",
      "appliesTo": "Account", "severity": "watch",
      "inputs": [
        { "name": "balance", "fact": "Account.balance", "maxAge": "freshness.credit", "requireAuthority": "source_of_truth" },
        { "name": "limit", "fact": "Account.creditLimit", "maxAge": "freshness.credit", "requireAuthority": "source_of_truth" }
      ],
      "formula": {
        "op": "compare", "cmp": "gte",
        "left": { "formula": { "op": "ratio", "num": { "input": "balance" }, "den": { "input": "limit" } } },
        "right": { "setting": "credit.useWatch" }
      },
      "settings": ["credit.useWatch"], "status": "draft",
      "wording": ["Credit use is at or above the watch level."]
    },
    {
      "signalId": "sig-account-attention", "name": "Account needs attention", "meaning": "Something is overdue on the account, or a ticket has passed the time promised for it.",
      "appliesTo": "Account", "severity": "watch",
      "inputs": [
        { "name": "overdue", "fact": "Account.overdue", "maxAge": "freshness.credit", "requireAuthority": "source_of_truth" }
      ],
      "formula": {
        "op": "or",
        "of": [
          { "op": "positive", "of": { "input": "overdue" } },
          { "op": "any", "of": { "over": "Account.tickets", "where": { "op": "is_past", "of": { "input": "Ticket.dueBy" } } } }
        ]
      },
      "settings": [], "status": "draft",
      "wording": ["Something on this account needs attention."]
    },
    {
      "signalId": "sig-ticket-pileup", "name": "Tickets piling up", "meaning": "How many open tickets the account has, against a watch level.",
      "appliesTo": "Account", "severity": "watch",
      "inputs": [],
      "formula": {
        "op": "compare", "cmp": "gte",
        "left": { "formula": { "op": "count", "of": { "over": "Account.tickets", "where": { "op": "compare", "cmp": "eq", "left": { "input": "Ticket.status" }, "right": { "text": "open" } } } } },
        "right": { "setting": "ticket.pileUp" }
      },
      "settings": ["ticket.pileUp"], "status": "draft",
      "wording": ["The account has as many open tickets as the watch level or more."]
    },
    {
      "signalId": "sig-old-urgent-ticket", "name": "Old high-priority ticket", "meaning": "An open high-priority ticket has waited longer than the set time.",
      "appliesTo": "Account", "severity": "watch",
      "inputs": [],
      "formula": {
        "op": "any",
        "of": {
          "over": "Account.tickets",
          "where": {
            "op": "and",
            "of": [
