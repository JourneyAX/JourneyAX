{
  "schemaVersion": "1.0.0",
  "ontologyId": "golden-v1",
  "enabled": true,
  "selfConnector": "jax-iq",
  "claimGuard": { "figures": "off" },
  "things": [
    {
      "thing": "Account",
      "meaning": "A customer account: charge (credit terms) or cash.",
      "aliases": ["account", "customer"],
      "group": "Customer",
      "status": "active",
      "key": { "canonical": "account_number", "pattern": "^ACC-\\d{4}$" },
      "keyKinds": [
        { "kind": "account_number", "system": "ace-erp", "evidence": "real_field", "caseRule": "upper", "ready": true },
        { "kind": "ct_unit_key", "system": "commercetools", "evidence": "real_field", "caseRule": "lower", "pattern": "^acc-\\d{4}$", "ready": true },
        { "kind": "sf_account_id", "system": "salesforce", "evidence": "real_field", "caseRule": "as_is", "pattern": "^[a-zA-Z0-9]{15,18}$", "ready": true },
        { "kind": "sf_account_note", "system": "salesforce", "evidence": "text_note", "caseRule": "upper", "ready": false },
        { "kind": "zd_tag", "system": "zendesk", "evidence": "tag", "caseRule": "lower", "ready": true }
      ],
      "labelFact": "Account.name",
      "searchFacts": ["Account.name"],
      "defaultFacts": ["Account.name", "Account.tier", "Account.terms", "Account.balance"],
      "expectedIn": ["ace-erp", "commercetools", "salesforce"]
    },
    {
      "thing": "Ticket",
      "meaning": "A support item raised for an account.",
      "aliases": ["ticket", "case", "support item"],
      "group": "Service",
      "status": "active",
      "key": { "canonical": "ticket_id", "pattern": "^\\d{1,12}$" },
      "keyKinds": [
        { "kind": "ticket_id", "system": "zendesk", "evidence": "real_field", "caseRule": "as_is", "ready": true }
      ],
      "labelFact": "Ticket.subject",
      "searchFacts": ["Ticket.subject"],
      "defaultFacts": ["Ticket.subject", "Ticket.priority", "Ticket.status"],
      "expectedIn": ["zendesk"]
    },
    {
      "thing": "Order",
      "meaning": "What a customer asked us to supply.",
      "aliases": ["order"],
      "group": "Sales",
      "status": "modelled_only",
      "key": { "canonical": "order_number", "pattern": "^ORD-\\d{6}$" },
      "keyKinds": [
        { "kind": "order_number", "system": "commercetools", "evidence": "real_field", "caseRule": "as_is", "ready": true }
      ],
      "labelFact": "Order.state",
      "searchFacts": ["Order.state"],
      "defaultFacts": ["Order.state"],
      "expectedIn": ["commercetools"]
    }
  ],
  "facts": [
    { "fact": "Account.name", "thing": "Account", "label": "Name", "meaning": "The account holder's trading name.", "type": "text", "freshnessKind": "reference", "allowStale": true },
    { "fact": "Account.status", "thing": "Account", "label": "Online status", "meaning": "Whether the online account is active. Not a credit hold.", "type": "text", "freshnessKind": "reference", "allowStale": true },
    { "fact": "Account.homeBranchCode", "thing": "Account", "label": "Home branch", "meaning": "The code of the branch that serves the account.", "type": "ref", "freshnessKind": "reference", "allowStale": true },
    { "fact": "Account.tier", "thing": "Account", "label": "Price tier", "meaning": "The price tier the ERP prices this account at.", "type": "enum", "enumValues": ["bronze", "silver", "gold"], "freshnessKind": "price", "allowStale": false },
    { "fact": "Account.terms", "thing": "Account", "label": "Payment terms", "meaning": "When the account must pay, as the ERP writes it.", "type": "text", "freshnessKind": "credit", "allowStale": false },
    { "fact": "Account.creditLimit", "thing": "Account", "label": "Credit limit", "meaning": "The most the ERP lets the account owe us.", "type": "money", "freshnessKind": "credit", "allowStale": false },
    { "fact": "Account.balance", "thing": "Account", "label": "Balance", "meaning": "What the account owes us today, from the ERP.", "type": "money", "freshnessKind": "credit", "allowStale": false, "claimClasses": ["catalog_fact"] },
    { "fact": "Account.overdue", "thing": "Account", "label": "Overdue", "meaning": "The part of the balance past its due date, from the ERP.", "type": "money", "freshnessKind": "credit", "allowStale": false },
    { "fact": "Account.lastPaid", "thing": "Account", "label": "Last payment", "meaning": "The date of the last payment the ERP recorded.", "type": "date", "freshnessKind": "credit", "allowStale": false },
    { "fact": "Account.openOrderCount", "thing": "Account", "label": "Open orders", "meaning": "How many orders are open (see the contract for which).", "type": "number", "freshnessKind": "order", "allowStale": false },
    { "fact": "Account.onCreditHold", "thing": "Account", "label": "On credit hold", "meaning": "Whether the account is stopped from ordering on credit. No system is bound yet.", "type": "boolean", "freshnessKind": "credit", "allowStale": false },
    { "fact": "Account.discountRate", "thing": "Account", "label": "Discount rate", "meaning": "The standing discount the account is given. No system is bound yet.", "type": "percent", "freshnessKind": "price", "allowStale": false },
    { "fact": "Order.state", "thing": "Order", "label": "State", "meaning": "Where the order is in its life, as the commerce platform writes it. No system is bound yet.", "type": "text", "freshnessKind": "order", "allowStale": false },
    { "fact": "Ticket.subject", "thing": "Ticket", "label": "Subject", "meaning": "The subject line the customer or the agent wrote.", "type": "text", "freshnessKind": "ticket", "allowStale": true, "freeText": true },
    { "fact": "Ticket.priority", "thing": "Ticket", "label": "Priority", "meaning": "How urgent the support desk rates the ticket.", "type": "enum", "enumValues": ["low", "normal", "high", "urgent"], "freshnessKind": "ticket", "allowStale": false },
    { "fact": "Ticket.status", "thing": "Ticket", "label": "Status", "meaning": "Whether the ticket is still open: new, open, pending and hold count as open.", "type": "enum", "enumValues": ["open", "closed"], "freshnessKind": "ticket", "allowStale": false },
    { "fact": "Ticket.created", "thing": "Ticket", "label": "Created", "meaning": "When the ticket was raised.", "type": "datetime", "freshnessKind": "ticket", "allowStale": true },
    { "fact": "Ticket.dueBy", "thing": "Ticket", "label": "Due by", "meaning": "When the support desk promised an answer, if it did.", "type": "datetime", "freshnessKind": "ticket", "allowStale": false },
    { "fact": "Ticket.tags", "thing": "Ticket", "label": "Tags", "meaning": "The labels on the ticket, including the account tag.", "type": "list", "freshnessKind": "ticket", "allowStale": true }
  ],
  "links": [
    { "link": "Account.orders", "from": "Account", "to": "Order", "meaning": "Orders the account placed.", "cardinality": "1:n", "rollsUpDivisions": true, "inverse": "Order.account" },
    { "link": "Order.account", "from": "Order", "to": "Account", "meaning": "The account an order was placed for.", "cardinality": "n:1", "inverse": "Account.orders" },
    { "link": "Account.tickets", "from": "Account", "to": "Ticket", "meaning": "Support items for the account.", "cardinality": "1:n" },
    { "link": "Order.tickets", "from": "Order", "to": "Ticket", "meaning": "Support items that mention the order.", "cardinality": "1:n" },
    { "link": "Account.orderTickets", "from": "Account", "to": "Ticket", "meaning": "Support items about the account's orders.", "cardinality": "1:n", "via": ["Account.orders", "Order.tickets"] }
  ],
