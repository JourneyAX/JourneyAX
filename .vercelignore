# Dependencies — exclude node_modules at every level
**/node_modules

# Build outputs
**/.next
**/dist
**/build
**/.turbo
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Vercel internal
**/.vercel

# Logs & misc
**/*.log
**/.DS_Store
**/coverage

# Backend service SOURCE (not deployed via Vercel).
# NOTE: We exclude src/ folders only — NOT package.json files.
# npm needs all workspace package.json manifests to build the workspace
# graph so that `turbo --filter=journeyax-web` can resolve correctly.
apps/api-gateway/src
apps/auth-service/src
apps/project-service/src
apps/product-service/src
apps/organization-service/src
apps/agent-commerce-service/src
apps/analytics-service/src
apps/lead-service/src
apps/data-service/src

# Heavy packages not needed for any Vercel frontend
packages/ingestion
packages/integration
packages/design-system
packages/configurator-core

# Scripts, docs & infra
scripts
docs
data
scratch
skills

# Root-level scratch/test files
check-*.ts
_finalstats.ts
test-*.js
test-*.ts
Dockerfile.template
cloudbuild.yaml
cloudbuild-*.yaml
